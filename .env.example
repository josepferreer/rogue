# Copia este fichero a .env y rellena los valores. Ver "Variables de entorno"
# en el README.

# Obligatorias. Publicas por diseno: la seguridad la pone la RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Base de las imagenes de ejercicios (scripts/mirror-exercise-images.mjs).
NEXT_PUBLIC_EXERCISE_IMG_BASE=

# Opcional. En Vercel sale de VERCEL_GIT_COMMIT_SHA.
NEXT_PUBLIC_BUILD_ID=

# SECRETA. Solo la usan los scripts de sembrado y de espejo de imagenes; ni la
# web ni NOA la leen. No la definas en Vercel.
SUPABASE_SECRET_KEY=
